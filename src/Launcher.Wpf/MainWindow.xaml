<Window x:Class="Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="McLauncher"
        Width="880" Height="580" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B21" Foreground="#E8E8EE"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="MinWidth" Value="180"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="MinWidth" Value="140"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#26262E"/>
      <Setter Property="Foreground" Value="#E8E8EE"/>
      <Setter Property="BorderBrush" Value="#3A3A44"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Background" Value="#3D7BFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 第一行：版本与账号 -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="版本" Margin="0,0,8,0"/>
      <ComboBox x:Name="VersionBox" DisplayMemberPath="Id" MinWidth="200"/>
      <CheckBox x:Name="ReleaseOnlyBox" Content="仅正式版" IsChecked="True"
                Margin="0,0,16,0" VerticalAlignment="Center" Checked="ReleaseOnlyBox_Changed" Unchecked="ReleaseOnlyBox_Changed"/>
      <TextBlock Text="玩家名" Margin="0,0,8,0"/>
      <TextBox x:Name="UserNameBox" Width="160" MaxLength="16"/>
      <TextBlock Text="内存(MB)" Margin="0,0,8,0"/>
      <ComboBox x:Name="MemoryBox" MinWidth="110" SelectedIndex="1">
        <ComboBoxItem Content="1024"/>
        <ComboBoxItem Content="2048"/>
        <ComboBoxItem Content="4096"/>
        <ComboBoxItem Content="6144"/>
      </ComboBox>
    </WrapPanel>

    <!-- 第二行：Java 与操作 -->
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="Java" Margin="0,0,8,0"/>
      <ComboBox x:Name="JavaBox" DisplayMemberPath="Path" MinWidth="420"/>
      <Button x:Name="RefreshJavaButton" Content="重新检测" Click="RefreshJava_Click" Margin="0,0,12,0"/>
      <Button x:Name="LaunchButton" Content="安装并启动" Click="Launch_Click" Width="130"/>
      <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Width="80" IsEnabled="False"
              Background="#4A4A55" Margin="8,0,0,0"/>
    </WrapPanel>

    <!-- 第三行：日志 -->
    <Border Grid.Row="2" Background="#15151A" CornerRadius="6" Padding="10">
      <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 Background="Transparent" BorderThickness="0" Foreground="#C9C9D4"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Margin="0"
                 MinWidth="0" Height="Auto"/>
      </ScrollViewer>
    </Border>

    <!-- 第四行：状态栏 -->
    <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,10,0,0" Foreground="#9A9AAA" Text="就绪"/>
  </Grid>
</Window>
